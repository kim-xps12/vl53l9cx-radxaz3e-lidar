# Start VL53L9CX capture + LiDAR Web Studio (port 8080) at boot.
# Installed by scripts/install_root.sh as /etc/systemd/system/vl53l9cx-web.service
#   sudo systemctl disable --now vl53l9cx-web   # stop auto-start (and stop now)
#   journalctl -u vl53l9cx-web                  # launcher output
[Unit]
Description=VL53L9CX point cloud web viewer (LiDAR Web Studio)
After=systemd-modules-load.service systemd-udev-settle.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=radxa
Environment=VL_WAIT=90
# /run/vl53l9cx (owned by radxa) holds the shutdown request file, see vl53l9cx-poweroff.path
RuntimeDirectory=vl53l9cx
Environment=VL_POWEROFF_FILE=/run/vl53l9cx/poweroff
ExecStart=/home/radxa/vl53l9cx/scripts/run_web.sh 8080
ExecStop=/home/radxa/vl53l9cx/scripts/stop.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
